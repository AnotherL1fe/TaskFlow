# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (docker-compose maps 5432)
DATABASE_URL=postgresql://taskflow:taskflow@localhost:5432/taskflow_db?schema=lib
DATABASE_URL_TEST=postgresql://taskflow:taskflow@localhost:5432/taskflow_test?schema=lib

# Auth
JWT_SECRET=change-me-to-a-long-random-string-min-16-chars
JWT_EXPIRES_IN=1d

# Telegram integration (optional in development)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFIER=console

# Weather integration (optional)
WEATHER_API_KEY=
WEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather
